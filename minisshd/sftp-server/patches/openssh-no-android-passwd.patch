+		synth_pw.pw_uid = getuid();
+		synth_pw.pw_gid = getgid();
+		synth_pw.pw_name = (char *)"android";
+		synth_pw.pw_passwd = (char *)"";
+		synth_pw.pw_gecos = (char *)"";
+		synth_pw.pw_dir = (char *)"/data/local/tmp";
+		synth_pw.pw_shell = (char *)"/system/bin/sh";
+		user_pw = &synth_pw;
 	}
 
 	return (sftp_server_main(argc, argv, user_pw));
