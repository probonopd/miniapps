--- a/sftp-server-main.c	2025-02-18 09:15:08.000000000 +0100
+++ b/sftp-server-main.c	2026-11-10 21:44:50.498081761 +0100
@@ -38,14 +38,25 @@
 main(int argc, char **argv)
 {
 	struct passwd *user_pw;
+	static struct passwd synth_pw;
 
 	/* Ensure that fds 0, 1 and 2 are open or directed to /dev/null */
 	sanitise_stdfd();
 
 	if ((user_pw = getpwuid(getuid())) == NULL) {
-		fprintf(stderr, "No user found for uid %lu\n",
-		    (u_long)getuid());
-		return 1;
+		/* Statically linked against glibc, running under Android's bionic: getpwuid()
+		 * can't see bionic's built-in passwd table, so it always returns NULL here -
