 static void commonsetup(void);
+static int is_lan_addr(const char *host);
+
+/* This build's whole auth model (see fill_passwd() in common-session.c) is a blank-password
+ * bypass meant for a private LAN only - reject anything else at accept() time, before any
+ * protocol or auth exchange, rather than relying on the network never forwarding this port. */
+static int is_lan_addr(const char *host) {
+	unsigned int second_octet;
+	if (strncmp(host, "127.", 4) == 0) return 1;
+	if (strncmp(host, "10.", 3) == 0) return 1;
+	if (strncmp(host, "192.168.", 8) == 0) return 1;
+	if (sscanf(host, "172.%u.", &second_octet) == 1 && second_octet >= 16 && second_octet <= 31) return 1;
+	if (strcmp(host, "::1") == 0) return 1;
+	/* fc00::/7 (unique local) and fe80::/10 (link-local) */
+	if (strncmp(host, "fc", 2) == 0 || strncmp(host, "fd", 2) == 0) return 1;
+	if (strncmp(host, "fe8", 3) == 0 || strncmp(host, "fe9", 3) == 0 ||
+			strncmp(host, "fea", 3) == 0 || strncmp(host, "feb", 3) == 0) return 1;
+	return 0;
+}
 
