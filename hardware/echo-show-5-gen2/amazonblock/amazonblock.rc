# exec blocks init, so the firewall is in place before class main starts netd,
# zygote and the Amazon daemons; a plain "start" would race them.  adbd is a
# permissive SELinux domain on this boot image, so iptables works there
# (init -> adbd transition is allowed).
on post-fs-data
    exec u:r:adbd:s0 root root -- /system/bin/sh /system/bin/amazonblock.sh early

service amazonblock /system/bin/sh /system/bin/amazonblock.sh
    user root
    group root
    oneshot
    disabled
    seclabel u:r:adbd:s0

# netd sets up its own OUTPUT chains when it starts, also after a crash, so
# the hook has to be checked again every time.
on property:init.svc.netd=running
    start amazonblock

on property:sys.boot_completed=1
    start amazonblock

# No firewall means no network: WLAN cannot come up without netd.
on property:init.svc.netd=running && property:amazonblock.state=failed
    stop netd

on property:amazonblock.state=failed
    stop netd
