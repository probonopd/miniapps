+static struct ice_candpair *best_valid_pair(const struct icem_comp *comp)
+{
+	struct ice_candpair *best = NULL;
+	bool controlled = comp->icem->lrole == ICE_ROLE_CONTROLLED;
+	struct le *le;
+
+	for (le = comp->icem->validl.head; le; le = le->next) {
+
+		struct ice_candpair *cp = le->data;
+
+		if (cp->comp != comp || cp->state != ICE_CANDPAIR_SUCCEEDED)
+			continue;
+
+		if (controlled && cp->nominated)
+			return cp;
+
+		if (!best || cp->pprio > best->pprio)
+			best = cp;
+	}
+
+	return best;
+}
+
