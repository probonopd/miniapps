 	((void *)(((char *)(r)) + NLMSG_ALIGN(sizeof(struct ifaddrmsg))))
+#undef IFLA_RTA
+#define IFLA_RTA(r)                                                           \
+	((void *)(((char *)(r)) + NLMSG_ALIGN(sizeof(struct ifinfomsg))))
+/* Callers pass signed and unsigned lengths; the system macro compares the
+ * u32 nlmsg_len with them directly, a sign mismatch where ssize_t is int. */
+#undef NLMSG_OK
+#define NLMSG_OK(nlh, len)                                                    \
+	((len) > 0 && (size_t)(len) >= sizeof(struct nlmsghdr) &&            \
+	 (nlh)->nlmsg_len >= sizeof(struct nlmsghdr) &&                       \
+	 (size_t)(nlh)->nlmsg_len <= (size_t)(len))
